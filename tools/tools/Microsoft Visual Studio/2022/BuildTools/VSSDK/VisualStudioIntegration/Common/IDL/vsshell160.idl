//----------------------------------------------------------------------------
// IVsInvalidateCachedCommandState
// A free-threaded alternative to IVsUIShell::UpdateCommandUI
//----------------------------------------------------------------------------
[
    uuid(0a026971-5a0e-45c9-9479-e62ab18b7de6),
    version(1.0),
    pointer_default(unique),
]
interface IVsInvalidateCachedCommandState : IUnknown
{
    // Invalidate ALL state for all commands in VS. Essentially a free-threaded version of
    // IVsUIShell::UpdateCommandUI. The update is always asynchronous and this method simply
    // marks it as needed and returns.
    HRESULT InvalidateCommandUIState();

    // Invalidates cached status for just one single command.
    HRESULT InvalidateSpecificCommandUIState(VSCommandId command);
};

