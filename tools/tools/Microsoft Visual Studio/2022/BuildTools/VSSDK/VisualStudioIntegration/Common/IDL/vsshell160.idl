{
}
cpp_quote("#define SID_SVsInvalidateCachedCommandState IID_SVsInvalidateCachedCommandState")


//----------------------------------------------------------------------------
// IVsUIContextEvents
// An event raised when a UI context goes from active / inactive (or vice-versa).
// This is allow free-threaded sign-ups for these events on IVsUIContextMonitor.
//----------------------------------------------------------------------------
[
    uuid(0393d191-94ac-4997-9310-2eac67495816),
    version(1.0),
    pointer_default(unique),
]
interface IVsUIContextEvents : IUnknown
{
    HRESULT OnContextChanged([in] GUID uiContext, [in] VARIANT_BOOL active);
};

//----------------------------------------------------------------------------
// Free-threaded service that allows read-only type access to UI context state
// and events to monitor changes to it.
//----------------------------------------------------------------------------
[
    uuid(2b663830-25e6-4a21-94a3-24322fa4f01d),
    version(1.0),
    pointer_default(unique),
]
interface IVsUIContextMonitor : IUnknown
{
    // This can optionally be checked to determine if UI contexts are even available. They won't be available, for instance,
    // when doing a command line build in the shell, during update configuration, etc...
    HRESULT AreUIContextsAvailable([out, retval] VARIANT_BOOL *pfAvailable);

    // Tests if the UI context is active or not
    HRESULT IsUIContextActive([in] GUID uiContext, [out, retval] VARIANT_BOOL *pfActive);

    // Advise for UI context activation status changed events
    HRESULT AdviseContextEvents([in] IVsUIContextEvents *callback, [out, retval] VSCOOKIE *cookie);

    // Unadvise from UI context activation status changed events
    HRESULT UndaviseContextEvents([in] VSCOOKIE cookie);
};

cpp_quote("struct __declspec(deprecated(\"IVsUIContextMonitor is deprecated, please use IVsUIContextManager.\")) IVsUIContextMonitor;")

