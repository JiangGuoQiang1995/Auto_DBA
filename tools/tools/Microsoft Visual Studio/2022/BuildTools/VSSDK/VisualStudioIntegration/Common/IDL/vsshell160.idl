//----------------------------------------------------------------------------
// VSDPIMODE
//----------------------------------------------------------------------------
// These are used for declaring the supported DPI awareness mode.
enum __VSDPIMODE
{
    VSDM_Unaware    = 0x01,
    VSDM_System     = 0x02,
    VSDM_PerMonitor = 0x03,
};

typedef DWORD VSDPIMODE;

//----------------------------------------------------------------------------
// IVsDpiAware
//----------------------------------------------------------------------------
// Implemented by objects that want to control which DPI awareness context in
// which their UI is created. Only tool windows/designers/editors with Win32
// and/or WinForms content need to use this interface; if the content is WPF,
// this interface is not needed.
//
// For tool windows this should be implemented in the same place IVsWindowPane
// or IOleObject is implemented such as on a native tool window class, or by
// the managed class that derives from ToolWindowPane.
//
// For designers the implementation location is TBD.
[
    uuid(2283D00F-C00F-405E-8C23-8D31CC714FDD),
    version(1.0),
    pointer_default(unique)
]
interface IVsDpiAware : IUnknown
{
    [propget] HRESULT Mode([out, retval] VSDPIMODE *dwMode);
};

