  <xs:complexType abstract="false" name="Button">
    <xs:complexContent>
      <xs:extension base="annotated">
        <xs:sequence>
          <xs:element name="Parent" type="Guid-ID" minOccurs="0" />
          <xs:element name="Icon" type="Guid-ID" minOccurs="0" />
