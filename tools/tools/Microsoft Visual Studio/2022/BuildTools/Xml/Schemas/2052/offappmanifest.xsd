                </xs:enumeration>
                <xs:enumeration value="ReadDocument">
                  <xs:annotation>
                    <xs:documentation>
                      包括 <b>Restricted</b> 权限，也使内容应用程序能够使用 <b>getSelectedDataAsync</b> 方法读取文档。
                    </xs:documentation>
                  </xs:annotation>
                </xs:enumeration>
                <xs:enumeration value="WriteDocument">
                  <xs:annotation>
                    <xs:documentation>
                      包括 <b>Restricted</b> 权限，也使内容应用程序能够使用 <b>setSelectedDataAsync</b> 方法写入到文档。
                    </xs:documentation>
                  </xs:annotation>
                </xs:enumeration>
                <xs:enumeration value="ReadWriteDocument">
                  <xs:annotation>
                    <xs:documentation>
                      包括 <b>ReadDocument</b> 和 <b>WriteDocument</b> 权限，也使内容应用程序能够使用所有写入方法、管理绑定和事件订阅。
                    </xs:documentation>
                  </xs:annotation>
                </xs:enumeration>
              </xs:restriction>
            </xs:simpleType>
          </xs:element>
          <xs:element name="AllowSnapshot" type="xs:boolean" minOccurs="0" maxOccurs="1">
            <xs:annotation>
